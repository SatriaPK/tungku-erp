{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5174 --strictPort",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview --host 0.0.0.0 --port 4174 --strictPort",
    "setup": "node scripts/setup.mjs",
    "test": "node --test tests/contract.test.js tests/notificationSocket.test.js",
    "test:e2e": "npm run build && playwright test",
    "test:install": "playwright install chromium",
    "test:live": "playwright test --config=playwright.live.config.js",
    "check": "npm test && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "axios": "1.20.0",
    "lucide-react": "0.544.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "vite": "8.3.2"
  },
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11.0.0 <12"
  },
  "packageManager": "npm@11.19.0"
}
