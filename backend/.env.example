APP_NAME="Tungku Studio ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tungku-studio
DB_USERNAME=root
DB_PASSWORD=

# Password default untuk seeder (wajib di produksi, opsional di lokal — fallback 'password')
SEED_DEFAULT_PASSWORD=

# Sanctum SPA authentication
SANCTUM_STATEFUL_DOMAINS=localhost:5173
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

RESEND_API_KEY=re_TmRrnDjx_C3SunBYptv8w8n9KdMztiNeq
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="marketing@tungku.com"
MAIL_FROM_NAME="${APP_NAME}"

# Resend campaign email API and webhook signing secret
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Payment Gateway Configuration
# Default gateway: midtrans, xendit, or manual
PAYMENT_DEFAULT_GATEWAY=midtrans
PAYMENT_EXPIRATION_HOURS=24

# Midtrans Payment Gateway
# Sign up: https://dashboard.midtrans.com/register
# Sandbox keys: https://dashboard.sandbox.midtrans.com/settings/config_info
# Production keys: https://dashboard.midtrans.com/settings/access_keys
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SANITIZED=true
MIDTRANS_3DS=true

# Xendit Payment Gateway
# Sign up: https://dashboard.xendit.co/register
# API keys: https://dashboard.xendit.co/settings/developers#api-keys
# Webhook token: https://dashboard.xendit.co/settings/developers#webhooks
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
XENDIT_IS_PRODUCTION=false

VITE_APP_NAME="${APP_NAME}"

# Separate Python recommendation microservice (not a frontend variable).
RECOMMENDATION_SERVICE_URL=https://tungku-recommendation.vercel.app
